{
    "name":  "purser",
    "private":  true,
    "version":  "0.1.0",
    "type":  "module",
    "engines":  {
                    "node":  "\u003e=20"
                },
    "scripts":  {
                    "dev":  "concurrently -n server,web -c cyan,magenta \"pnpm --filter @purser/server dev\" \"pnpm --filter @purser/web dev\"",
                    "build":  "pnpm -r build",
                    "test":  "pnpm -r --if-present test",
                    "typecheck":  "pnpm -r --if-present typecheck",
                    "lint":  "eslint .",
                    "check:secrets":  "node scripts/check-secrets.mjs",
                    "hooks:install":  "node scripts/install-hooks.mjs",
                    "prepare":  "node scripts/install-hooks.mjs",
                    "demo:verify":  "pnpm --filter @purser/agent verify",
                    "demo:warm":  "pnpm --filter @purser/agent warm"
                },
    "devDependencies":  {
                            "@eslint/js":  "^10.0.1",
                            "@types/node":  "^26.6.6",
                            "concurrently":  "^10.0.7",
                            "eslint":  "^10.14.0",
                            "tsx":  "^4.23.15",
                            "typescript":  "^6.0.3",
                            "typescript-eslint":  "^8.72.2",
                            "vitest":  "^5.1.0"
                        }
}
