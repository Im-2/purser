PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
BUSINESS_EMAIL=
VENDOR_ACME_EMAIL=
VENDOR_NORTHWIND_EMAIL=
PURSER_ADMIN_TOKEN=
# Public base URL of the server; the dashboard origin allowed by CORS. On Render leave it unset: RENDER_EXTERNAL_URL is used.
PUBLIC_URL=http://127.0.0.1:8799
RENDER_EXTERNAL_URL=
# stdio = the pinned @paypal/mcp installed with the app (default) | npx = `npx -y @paypal/mcp` | off = native tools only
UPSTREAM_MODE=stdio
NODE_ENV=
LOG_LEVEL=info
PORT=8799
DATABASE_PATH=./data/purser.db
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AGENT_API_KEY=

# --- AI layer (payment reviewer + plain-English policy compiler) ---
# Provider-agnostic. openai_compat works with any OpenAI-compatible /chat/completions endpoint.
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1                          LLM_MODEL=openai/gpt-oss-120b
#   Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai LLM_MODEL=gemini-2.5-flash
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1                            LLM_MODEL=<any model id>
#   Anthropic:  LLM_PROVIDER=anthropic (LLM_BASE_URL optional, defaults to https://api.anthropic.com)
# If no provider is configured the reviewer fails closed (escalates) and policy compile is unavailable.
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# none | low | medium | high. Sent as reasoning_effort when the endpoint supports it (dropped automatically if not).
LLM_REASONING_EFFORT=low
# Per-request timeout in ms. A timeout or HTTP 429 waits and retries once, then fails closed (escalate).
LLM_TIMEOUT_MS=20000
# How long a cached reviewer verdict stays fresh (seconds). 0 disables fresh hits.
AI_CACHE_TTL_SEC=86400
# live = call the model on a cache miss. cached_only = replay mode: never call the model, use cached verdicts only.
AI_MODE=live

# Legacy fallback, used only when LLM_PROVIDER is unset.
ANTHROPIC_API_KEY=
PURSER_MODEL=claude-sonnet-5-5
